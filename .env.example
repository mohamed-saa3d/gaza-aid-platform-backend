# ==========================================
# SERVER & APP CONFIG
# ==========================================
NODE_ENV=production
PORT=5000
API_PREFIX=/api
FRONTEND_URL=https://qaza.org
ADMIN_PANEL_URL=https://admin.qaza.org

# ==========================================
# DATABASE (Prisma / MongoDB Atlas)
# ==========================================
# Make sure to use SSL/TLS connection in production.
DATABASE_URL="mongodb+srv://<USERNAME>:<PASSWORD>@cluster.mongodb.net/qaza_prod_db?retryWrites=true&w=majority"

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Generate random secrets, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ==========================================
# PAYMENTS & GATEWAYS
# ==========================================
STRIPE_SECRET_KEY=sk_live_replace_with_actual_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_actual_key
FAWRY_MERCHANT_CODE=replace_me
FAWRY_SECURITY_KEY=replace_me

# ==========================================
# EMAIL SERVICE (SMTP)
# ==========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace_with_smtp_key
EMAIL_FROM="Qaza Platform <noreply@qaza.org>"
FROM_EMAIL="Qaza Platform <noreply@qaza.org>"

# ==========================================
# RATE LIMITING & CORS
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ALLOWED_ORIGINS=https://qaza.org,https://admin.qaza.org
