model PlatformRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  value     Int
  comment   String?
  // Set for authenticated ratings, null for guest ratings.
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of a server-issued visitor cookie - never raw PII, never the
  // cookie value itself. Used only to stop one guest rating repeatedly.
  guestKey  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestKey])
  @@index([createdAt])
}
