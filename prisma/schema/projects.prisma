model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nameAr    String   @unique
  nameEn    String   @unique
  descriptionAr String?
  descriptionEn String?
  // Icon key rendered by the frontend category strip (e.g. "Droplets").
  // A plain string key, not an enum: the frontend owns the icon map, so adding a
  // new icon never requires a database migration.
  icon      String   @default("LayoutGrid")
  // Display order. Default categories keep their intended order (0-5) even after
  // an admin renames them, because identity is the id and the order is stored.
  order     Int      @default(100)
  createdAt DateTime @default(now())

  projects Project[]

  @@index([order])
}

model Project {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  titleAr         String
  titleEn         String
  descriptionAr   String
  descriptionEn   String
  imgUrl          String        @default("https://via.placeholder.com/600x400?text=No+Image")
  imgPublicId     String?
  targetAmount    Int
  collectedAmount Int           @default(0)
  beneficiariesCount Int         @default(0)
  status          ProjectStatus @default(ACTIVE)
  isUrgent        Boolean       @default(false)

  categoryId String?    @db.ObjectId
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  donations  Donation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([isUrgent])
  @@index([createdAt])
}
