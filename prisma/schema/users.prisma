model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String   @unique
  passwordHash    String
  image           String?
  role            Role     @default(DONOR)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  donations Donation[]
  ratings  Rating[]
  tokens    AuthToken[]
  wallet    Wallet?
  paymentIntents PaymentIntent[]
}
