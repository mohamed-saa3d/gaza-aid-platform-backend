enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  token     String
  type      TokenType
  expiresAt DateTime
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, token])
}
