model News {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  titleAr       String
  titleEn       String
  descriptionAr String
  descriptionEn String
  imageUrl      String
  detailsUrl    String?
  isUrgent      Boolean  @default(false)
  createdAt     DateTime @default(now())
}
